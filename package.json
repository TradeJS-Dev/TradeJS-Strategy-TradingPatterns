{
  "name": "@tradejs/strategy-trading-patterns",
  "version": "0.1.0",
  "description": "One-hour composite strategy that evaluates all TradeJS chart-pattern strategies and emits one deterministic decision per candle.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "tradejs",
    "trading",
    "strategy",
    "plugin",
    "backtesting",
    "crypto",
    "chart-patterns",
    "harmonic-patterns",
    "ai",
    "claude",
    "codex"
  ],
  "homepage": "https://tradejs.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/TradeJS-Dev/TradeJS-Strategy-TradingPatterns"
  },
  "bugs": {
    "url": "https://github.com/TradeJS-Dev/TradeJS-Strategy-TradingPatterns/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@tradejs/core": "^3.0.1",
    "@tradejs/strategy-bat": "^0.1.1",
    "@tradejs/strategy-crab": "^0.1.1",
    "@tradejs/strategy-cup-and-handle": "^3.0.4",
    "@tradejs/strategy-diamond": "^0.1.1",
    "@tradejs/strategy-double-tap": "^3.0.3",
    "@tradejs/strategy-dragon": "^0.1.1",
    "@tradejs/strategy-five-zero": "^0.1.1",
    "@tradejs/strategy-flag": "^0.1.3",
    "@tradejs/strategy-gartley": "^0.1.1",
    "@tradejs/strategy-head-and-shoulders": "^3.0.5",
    "@tradejs/strategy-kit": "^3.0.5",
    "@tradejs/strategy-shark": "^0.1.1",
    "@tradejs/strategy-triangle": "^0.1.0",
    "@tradejs/types": "^3.0.1",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "audit:geometry": "node scripts/audit-export-geometry.mjs",
    "build": "tsup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "checks": "yarn format:check && yarn typecheck && yarn test && yarn build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "BUSL-1.1",
  "author": "aleksnick (https://github.com/aleksnick)",
  "peerDependencies": {
    "@tradejs/core": "^3.0.1",
    "@tradejs/strategy-bat": "^0.1.1",
    "@tradejs/strategy-crab": "^0.1.1",
    "@tradejs/strategy-cup-and-handle": "^3.0.4",
    "@tradejs/strategy-diamond": "^0.1.1",
    "@tradejs/strategy-double-tap": "^3.0.3",
    "@tradejs/strategy-dragon": "^0.1.1",
    "@tradejs/strategy-five-zero": "^0.1.1",
    "@tradejs/strategy-flag": "^0.1.3",
    "@tradejs/strategy-gartley": "^0.1.1",
    "@tradejs/strategy-head-and-shoulders": "^3.0.5",
    "@tradejs/strategy-kit": "^3.0.5",
    "@tradejs/strategy-shark": "^0.1.1",
    "@tradejs/strategy-triangle": "^0.1.0",
    "@tradejs/types": "^3.0.1"
  }
}
